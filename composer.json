{
    "name": "epptools/sdk",
    "description": "Standalone PHP client for EPP domain registries — RFC 5730-5734 over TLS, with a registry's own extensions discovered from its greeting. No framework, no project code.",
    "type": "library",
    "keywords": ["epp", "registry", "registrar", "domains", "rfc5730", "rfc5731", "rfc5910", "client", "sdk"],
    "homepage": "https://github.com/epptools/php-sdk",
    "license": "MIT",
    "authors": [
        { "name": "EppTools", "homepage": "https://github.com/epptools" }
    ],
    "require": {
        "php": ">=8.0",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-openssl": "*",
        "ext-mbstring": "*",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "suggest": {
        "monolog/monolog": "Any PSR-3 logger (e.g. Monolog) can be passed to Client for redacted command/frame logging"
    },
    "support": {
        "issues": "https://github.com/epptools/php-sdk/issues",
        "docs": "https://github.com/epptools/php-sdk/blob/main/docs/en/README.md",
        "source": "https://github.com/epptools/php-sdk"
    },
    "autoload": {
        "psr-4": { "EppTools\\": "src/" }
    },
    "scripts": {
        "test": "@php tests/offline_test.php"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}


